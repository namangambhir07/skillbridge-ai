# SkillBridge AI Environment Variables

# Backend Service
PORT=5000
NODE_ENV=development

# Authentication
JWT_SECRET=skillbridge_super_secret_jwt_key_hackathon_2026

# CORS
CORS_ORIGIN=http://localhost:5173

# Database configuration:
# For production (Neon, Supabase, AWS RDS, Render, Railway):
# DATABASE_URL=postgresql://user:password@ep-your-db.us-east-1.aws.neon.tech/neondb?sslmode=require
#
# For local persistent PostgreSQL:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/skillbridge_ai
#
# If left empty, SkillBridge AI falls back to in-memory PostgreSQL for zero-config offline dev and testing.
DATABASE_URL=

# Optional AI Engine Key
LLM_API_KEY=
